{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airlock",
  "version": "1.3.0",
  "identifier": "com.silvestre.airlock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Airlock",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SilesterGold9",
    "copyright": "Copyright © 2026 SilesterGold9",
    "homepage": "https://github.com/SilesterGold9/airlock",
    "category": "Education",
    "shortDescription": "Offline-first competitive programming trainer",
    "longDescription": "Airlock is an offline-first competitive programming trainer: local problem vault, local judge (C++ and Java), ICPC-style contests, and a built-in training methodology.",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNzgzRTgxNEVDQzA4N0UKUldSK0NNeE9nVDU0UW4xTE5kZWRTeHBjRUJYT24rbkU1VXY5dDJPY0pMbVpzWExvSXJLM2hMbFUK",
      "endpoints": [
        "https://github.com/SilesterGold9/airlock/releases/latest/download/latest.json"
      ]
    }
  }
}
